<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pertemuan 5: izin akses internet (WebView) dan Pertemuan 10 (Glide memuat gambar dari URL) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rizky3TIB">

        <!-- Pertemuan 6: SplashScreenActivity (LAUNCHER / Halaman Pertama) -->
        <activity
            android:name=".Home.pertemuan_6.SplashScreenActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pertemuan 6: AuthActivity -->
        <activity
            android:name=".Home.pertemuan_6.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

