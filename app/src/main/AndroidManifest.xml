<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rizky3TIB">

        <!-- SplashScreenActivity (Dibuat LAUNCHER / Halaman Pertama Buka App) -->
        <activity
            android:name=".Pertemuan6.SplashScreenActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AuthActivity (Halaman Login) -->
        <activity
            android:name=".Pertemuan6.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- BaseActivity (Halaman Home Setelah Login) -->
        <activity
            android:name=".BaseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- MainActivity -->
        <activity
            android:name=".Pertemuan2.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- LoginActivity -->
        <activity
            android:name=".Pertemuan3.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- FourthActivity -->
        <activity
            android:name=".pertemuan4.FourthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- FifthActivity -->
        <activity
            android:name=".Pertemuan5.FifthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- WebViewActivity -->
        <activity
            android:name=".Pertemuan5.WebViewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- SeventhActivity -->
        <activity
            android:name=".Pertemuan7.SeventhActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>